# Nebius Token Factory (OpenAI-compatible) — https://tokenfactory.nebius.com
NEBIUS_API_KEY=your_nebius_token_factory_key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NVIDIA open model served on Nebius Token Factory
NEMOTRON_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5
# Tavily real-time web search — https://tavily.com
TAVILY_API_KEY=your_tavily_key
# Set to 1 to run with canned responses (no keys needed) for UI testing
MOCK_MODE=0
